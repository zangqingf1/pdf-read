# ========== Database ==========
# Docker Compose 环境自动使用 PostgreSQL，本地开发使用 SQLite
# 本地开发时忽略 DB_PASSWORD（仅 Docker 使用）
DATABASE_URL=sqlite+aiosqlite:///./pdfreader.db
DATABASE_URL_SYNC=sqlite:///./pdfreader.db
DB_PASSWORD=pdfreader_pass

# ========== DeepSeek API ==========
# 注册地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ========== MinerU Cloud API (PDF 解析) ==========
# 注册地址: https://mineru.net
MINERU_API_TOKEN=your_mineru_token_here
MINERU_API_BASE=https://mineru.net

# ========== App ==========
SECRET_KEY=change-me-in-production
ENVIRONMENT=production
DEBUG=false

# ========== File Upload ==========
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
