# ========== Database ==========
# Docker Compose 环境自动使用 PostgreSQL，本地开发使用 SQLite
# 本地开发时忽略 DB_PASSWORD（仅 Docker 使用）
DATABASE_URL=sqlite+aiosqlite:///./pdfreader.db
DATABASE_URL_SYNC=sqlite:///./pdfreader.db
DB_PASSWORD=pdfreader_pass

# ========== DeepSeek API ==========
# 注册地址: https://platform.deepseek.com/api_keys
# ⚠️ 此处留空 — 用户必须通过前端页面右上角🔑图标自行提供 API Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash


# ========== MinerU Cloud API (PDF 解析) ==========
# 注册地址: https://mineru.net
# ⚠️ 此处留空 — 用户必须通过前端页面右上角🔑图标自行提供 Token
MINERU_API_TOKEN=
MINERU_API_BASE=https://mineru.net

# ========== App ==========
SECRET_KEY=change-me-in-production
ENVIRONMENT=production
DEBUG=false

# ========== JWT / Auth ==========
# JWT_SECRET_KEY 为空时自动回退使用 SECRET_KEY
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ========== CORS ==========
# 生产环境替换为实际域名，多个用逗号分隔
# 部署时 deploy.sh 会自动追加服务器公网 IP
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,http://127.0.0.1,http://47.109.147.248

# ========== File Upload ==========
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
