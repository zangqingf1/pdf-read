# ========== Database ==========
# Docker Compose 环境自动使用 PostgreSQL，本地开发使用 SQLite
# 本地开发时忽略 DB_PASSWORD（仅 Docker 使用）
DATABASE_URL=sqlite+aiosqlite:///./pdfreader.db
DATABASE_URL_SYNC=sqlite:///./pdfreader.db
# 生产部署必须改为强随机值（docker-compose 未设置会直接拒绝启动）
DB_PASSWORD=pdfreader_pass

# ========== DeepSeek API ==========
# 注册地址: https://platform.deepseek.com/api_keys
# ⚠️ 此处留空 — 用户必须通过前端页面右上角🔑图标自行提供 API Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash


# ========== MinerU Cloud API (PDF 解析) ==========
# 注册地址: https://mineru.net
# ⚠️ 此处留空 — 用户必须通过前端页面右上角🔑图标自行提供 Token
MINERU_API_TOKEN=
MINERU_API_BASE=https://mineru.net

# ========== App ==========
# 生产部署必须改为强随机值（docker-compose 未设置会直接拒绝启动）
SECRET_KEY=change-me-in-production
ENVIRONMENT=production
DEBUG=false

# ========== JWT / Auth ==========
# JWT_SECRET_KEY 为空时自动回退使用 SECRET_KEY
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ========== Email (注册/找回密码验证码) ==========
# ⚠️ 未配置 SMTP 时：开发环境验证码打印到后端日志并在 API 响应返回 dev_code，
#    生产环境发送接口返回 503。配置示例（QQ 邮箱）：
#   SMTP_HOST=smtp.qq.com
#   SMTP_PORT=465
#   SMTP_USER=your@qq.com
#   SMTP_PASSWORD=授权码
#   SMTP_SECURITY=ssl          # ssl(465) | starttls(587) | none
#   SMTP_FROM=your@qq.com      # 留空回退到 SMTP_USER
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=ssl
SMTP_TIMEOUT=15
# 验证码有效期/长度/最大尝试次数
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_LENGTH=6
EMAIL_CODE_MAX_ATTEMPTS=5
# 发送频率限制（同一邮箱冷却/小时上限，同一 IP 小时上限）
EMAIL_SEND_COOLDOWN_SECONDS=60
EMAIL_MAX_PER_HOUR=5
EMAIL_MAX_PER_IP_PER_HOUR=10

# ========== Login 暴力破解限流（进程内，按邮箱+IP） ==========
LOGIN_MAX_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# ========== Avatar ==========
AVATAR_MAX_MB=2

# ========== CORS ==========
# 生产环境替换为实际域名，多个用逗号分隔
# 部署时 deploy.sh 会自动追加服务器公网 IP
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,http://127.0.0.1,http://47.109.147.248

# ========== File Upload ==========
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# ========== PDF Export (Chrome 无头渲染) ==========
# 留空时自动探测 PATH / 常见安装路径中的 Chrome/Edge，或手动指定可执行文件路径
CHROME_PATH=
PDF_EXPORT_HTML_MAX_MB=5
PDF_EXPORT_TIMEOUT_SECONDS=45
PDF_EXPORT_CONCURRENCY=2
PDF_EXPORT_VIRTUAL_TIME_MS=5000
# ⚠️ 服务器必须安装中文字体，否则导出 PDF 中文乱码（方框/缺字形）
#   RHEL 系 (Alibaba Cloud Linux / CentOS / Rocky): dnf install -y google-noto-sans-cjk-ttc-fonts
#   Ubuntu/Debian:                                apt install -y fonts-noto-cjk
